<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightGreen"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:backgroundTint="@color/colorAccent"
        android:onClick="sendMessage"
        android:textAllCaps="false"
        android:text="@string/send_button" />

    <TextView
        android:id="@+id/messageTextArea"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_margin="10dp"
        android:scrollbars="vertical"
        android:textSize="14sp">

    </TextView>

    <LinearLayout
        android:layout_width="400dp"
        android:layout_height="110dp"
        android:layout_below="@+id/messageTextArea"
        android:layout_margin="5dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <Button
            android:id="@+id/toMian"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_alignEnd="@+id/button"
            android:layout_alignParentBottom="true"

            android:layout_marginBottom="10dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:onClick="toFirstScreen"
            android:textAllCaps="false"
            android:text="@string/to_first_screen" />

        <Button
            android:id="@+id/cleanMain"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_alignEnd="@+id/button"
            android:layout_alignParentBottom="true"
            android:layout_weight="1"
            android:backgroundTint="@color/colorPrimary"
            android:onClick="cleanMainDisplay"
            android:textAllCaps="false"
            android:text="@string/clean_main" />

        <Button
            android:id="@+id/exitButton"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_alignTop="@+id/cleanMain"
            android:layout_alignParentStart="true"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:backgroundTint="@color/lightgold"
            android:onClick="exitApp"
            android:text="@string/closeButton" />
    </LinearLayout>
</LinearLayout>
