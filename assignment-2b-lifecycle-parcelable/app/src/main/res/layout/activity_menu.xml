<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"

    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightgold"
    android:orientation="vertical"
    tools:context=".MenuActivity">

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="toUnderstandOnCreate"
        android:text="@string/understanding_oncreate"
        android:textAllCaps="false"
        android:textStyle="normal" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="toLifeCycle"
        android:text="@string/life_cycle_domonstration"
        android:textAllCaps="false"
        android:textStyle="normal" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="toParcellable"
        android:text="@string/parcellable_domonstration"
        android:textAllCaps="false"
        android:textStyle="normal" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="toRestorActivity"
        android:text="@string/restore_domonstration"
        android:textAllCaps="false"
        android:textStyle="normal" />

</LinearLayout>